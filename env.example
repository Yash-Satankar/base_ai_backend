# ── App ──────────────────────────────────────────────────────────
APP_NAME=AI DB Schema Generator
APP_VERSION=1.0.0
DEBUG=False                        # Set True for local dev (enables /docs, skips JWT check)

# ── AI Provider ───────────────────────────────────────────────────
# One of: groq | together | anthropic | ollama
AI_PROVIDER=groq

# Groq — free tier at https://console.groq.com/  (8000 TPM cap on free tier)
GROQ_API_KEY=your_groq_api_key_here
# Groq's llama-3.x ids were decommissioned in 2025 — use the gpt-oss lineup.
GROQ_MODEL=openai/gpt-oss-120b

# Together AI — https://api.together.xyz/  (OpenAI-compatible, hosts the gpt-oss lineup)
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=openai/gpt-oss-120b
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_TIMEOUT_SECONDS=240
# gpt-oss reasoning tokens count against max_tokens — "low" prevents a dense
# prompt from spending the whole budget on reasoning and returning no output.
TOGETHER_REASONING_EFFORT=low

# ── Generation Settings ───────────────────────────────────────────
MAX_TOKENS=12000
TOP_K_RULES=15
AI_TIMEOUT_SECONDS=120

# ── Qdrant (Vector Search for Rule Engine) ────────────────────────
# Get free cloud instance at: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=db_rules

# ── PostgreSQL ────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/base_ai

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=86400            # Session TTL in seconds (default: 24 hours)

# ── Security ──────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET to a strong random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_this_with_a_strong_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440          # 24 hours

# Master API key for admin access (leave empty to disable)
MASTER_API_KEY=

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Comma-separated staff emails allowed to request the internal debug
# response projection (send `X-Debug: true`). This exposes L1-L7 metadata,
# rule IDs, and provider/model names that the default API contract omits.
# Leave empty so only the master API key qualifies.
DEBUG_VIEW_EMAILS=

# ── Embedding Model ───────────────────────────────────────────────
# Downloaded automatically on first run from HuggingFace
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── MySQL Execution Validation (optional post-validator gate) ─────
# Runs the generated DDL against a REAL MySQL 8 after the structural
# SchemaValidator. Off by default (slow — real DB spin-up).
MYSQL_EXEC_VALIDATION_ENABLED=False
# Optional: an existing MySQL 8 server. A scratch DB is created + dropped
# per run. e.g. mysql://root:test@localhost:3310/  — start one with:
#   docker compose --profile validation up -d mysql-test
# When unset and Docker is available, an ephemeral testcontainers MySQL is used.
MYSQL_EXEC_VALIDATION_DSN=
MYSQL_EXEC_VALIDATION_USE_TESTCONTAINER=True
MYSQL_EXEC_VALIDATION_TIMEOUT=90

# ── Auto-iteration schema refinement (post-generation stage) ──────
# Loops schema_validator + mysql_execution_validator and feeds concrete
# findings back to the LLM for a targeted fix. Off by default (LLM cost per
# iteration). A cost-degraded conversation is capped to 1 iteration.
SCHEMA_REFINE_ENABLED=False
SCHEMA_REFINE_MAX_ITERATIONS=3
SCHEMA_REFINE_ADVISORY_THRESHOLD=5
SCHEMA_REFINE_MAX_TOKENS=8000
